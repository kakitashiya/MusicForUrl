{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "music-for-url",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "vars": {
    "AUDIO_CACHE_ENABLED": "false"
  },
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "mfu_playback" },
    { "binding": "ANALYTICS_REQUESTS", "dataset": "mfu_requests" }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "music-for-url",
      "database_id": "97dbb40f-1a64-499b-8ac0-afbb140bf4e1"
    }
  ]
}
